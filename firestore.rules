rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isConversationMember() {
      return isSignedIn() && request.auth.uid in resource.data.memberIds;
    }

    function isConversationMemberOnCreate() {
      return isSignedIn() && request.auth.uid in request.resource.data.memberIds;
    }

    function isDirectConversationCreate() {
      return request.resource.data.type == "direct"
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 2;
    }

    function isGroupConversationCreate() {
      return request.resource.data.type == "group"
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() >= 2
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
    }

    function isConversationParticipant(conversationId) {
      return isSignedIn()
        && request.auth.uid in
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
    }

    function allowedUserDocumentKeys() {
      return [
        "uid",
        "email",
        "displayName",
        "photoURL",
        "createdAt",
        "updatedAt",
        "lastSeenAt",
        "fcmTokens",
      ];
    }

    function isSafeUserSelfUpdate() {
      return request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly(allowedUserDocumentKeys())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedUserDocumentKeys())
        && (!("fcmTokens" in request.resource.data) || request.resource.data.fcmTokens is list);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId && isSafeUserSelfUpdate();
    }

    match /conversations/{conversationId} {
      allow read: if isConversationMember();
      allow create: if isConversationMemberOnCreate()
        && (isDirectConversationCreate() || isGroupConversationCreate());
      allow update: if isConversationMember();

      match /messages/{messageId} {
        allow read: if isConversationParticipant(conversationId);
        allow create: if isConversationParticipant(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.conversationId == conversationId;
      }
    }
  }
}
